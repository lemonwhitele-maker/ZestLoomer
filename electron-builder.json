{
  "appId": "io.loom.novelworkspace.preview",
  "productName": "Loom Preview",
  "copyright": "See LICENSE and THIRD-PARTY-NOTICES.txt",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": ["out/**/*", "package.json"],
  "extraResources": [
    { "from": "LICENSE", "to": "licenses/Loom-LICENSE.txt" },
    {
      "from": "docs/third-party-editor-licenses.txt",
      "to": "licenses/third-party-editor-licenses.txt"
    },
    { "from": "THIRD-PARTY-NOTICES.txt", "to": "licenses/THIRD-PARTY-NOTICES.txt" }
  ],
  "asar": true,
  "publish": null,
  "afterPack": "./scripts/release/after-pack.mjs",
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "src/shared/assets/loom-logo.png",
    "executableName": "LoomPreview",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "artifactName": "LoomPreview-${version}-win-${arch}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "packElevateHelper": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Loom Preview",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "installerLanguages": ["zh_CN", "en_US"],
    "displayLanguageSelector": true,
    "license": "LICENSE"
  }
}
