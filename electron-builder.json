{
  "appId": "io.zestloomer.novelworkspace",
  "productName": "ZestLoomer",
  "copyright": "See LICENSE and THIRD-PARTY-NOTICES.txt",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": ["out/**/*", "package.json"],
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "licenses/ZestLoomer-LICENSE.txt"
    },
    {
      "from": "docs/third-party-editor-licenses.txt",
      "to": "licenses/third-party-editor-licenses.txt"
    },
    {
      "from": "THIRD-PARTY-NOTICES.txt",
      "to": "licenses/THIRD-PARTY-NOTICES.txt"
    }
  ],
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "src/shared/assets/zestloomer-logo.png",
    "executableName": "ZestLoomer",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "artifactName": "ZestLoomer-${version}-win-${arch}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ZestLoomer",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "installerLanguages": ["zh_CN", "en_US"],
    "displayLanguageSelector": true,
    "license": "LICENSE"
  },
  "artifactName": "ZestLoomer-${version}-win-${arch}.${ext}"
}
